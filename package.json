{
  "name": "expande-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -k \"node --env-file-if-exists=.env --import tsx --watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "test": "node --experimental-transform-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:docker": "node tests/docker-smoke.mjs",
    "format": "prettier --write src server shared tests docs README.md AGENTS.md package.json tsconfig.json vite.config.ts playwright.config.ts compose.yaml .prettierrc.json",
    "data": "node --env-file-if-exists=.env --experimental-transform-types server/cli.ts",
    "data:remote": "node --env-file-if-exists=.env --experimental-transform-types server/remote-cli.ts",
    "db:init": "node --env-file-if-exists=.env --experimental-transform-types server/cli.ts init",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/static": "^10.1.10",
    "@fontsource-variable/rubik": "5.3.0",
    "@libsql/client": "^0.18.0",
    "ajv": "^8.17.1",
    "fastify": "^5.6.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
